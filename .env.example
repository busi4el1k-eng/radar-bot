# Rulează `python setup.py` pentru configurare interactivă (recomandat),
# sau copiază acest fișier în .env și completează manual valorile.

# Token-ul botului, de la @BotFather (/newbot)
BOT_TOKEN=123456789:AAF...

# ID-ul canalului (redirecționează un mesaj din canal către @userinfobot)
# sau @numecanal pentru canale publice
CHANNEL_ID=-1001234567890

# ID-ul tău de Telegram (de la @userinfobot); mai multe ID-uri separate prin virgulă
ADMIN_IDS=123456789

# Connection string-ul de la Neon (dashboard → Connection Details); Neon cere SSL
DATABASE_URL=postgresql://user:parola@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# ── Agregatorul de știri (opțional) ──
# Filtru AI: clasifică itemele agregate și scrie draftul descrierii (true/false)
USE_AI_FILTER=false
# Cheia OpenAI (necesară doar dacă USE_AI_FILTER=true)
OPENAI_API_KEY=
# Modelul OpenAI (ieftin) folosit de filtru
AI_MODEL=gpt-4o-mini
# La câte ore rulează automat agregatorul
PULL_INTERVAL_HOURS=6
# Semnătura de la finalul postărilor publicate din inbox (poate fi goală)
POST_FOOTER=⚡️ @numecanal
# Opțional: token GitHub (ridică limita API de la 60 la 5000 cereri/oră)
GITHUB_TOKEN=
